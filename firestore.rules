rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these two Google accounts can read or change anything.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['YOUR_EMAIL@gmail.com', 'HUSBAND_EMAIL@gmail.com'];
    }
  }
}
